# 应用配置面板
VITE_APP_SETTING = true

# 页面标题
VITE_APP_TITLE = HOAI

# 本地开发一般为根路径；生产见 .env.production 的 /admin/
VITE_BASE_PATH = /

# 接口请求地址，会设置到 axios 的 baseURL 参数上
VITE_APP_API_BASEURL = http://127.0.0.1:9520/api

# localStorage/sessionStorage 前缀
VITE_APP_STORAGE_PREFIX = fa_dev_

# 调试工具，可设置 eruda 或 vconsole，如果不需要开启则留空
VITE_APP_DEBUG_TOOL =

# 兼容旧版变量：是否开启代理（与 VITE_ENABLE_PROXY 任一为 true 即开启）
VITE_OPEN_PROXY = false

# ===== 以下配置仅在开发环境生效 =====

# 启用代理
VITE_ENABLE_PROXY = false

# 启用 Vue 开发工具
VITE_ENABLE_VUE_DEVTOOLS = false

# 启用 turbo console
VITE_ENABLE_TURBO_CONSOLE = false

VITE_LAUNCH_EDITOR = code
