# 端口
PORT=9520

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_DATABASE=chatgpt

# Redis
REDIS_PORT=6379
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_USER=
REDIS_DB=0

# 是否测试环境
ISDEV=false

# 自定义微信URL
weChatOpenUrl=https://open.weixin.qq.com
weChatApiUrl=https://api.weixin.qq.com
weChatApiUrlToken=https://api.weixin.qq.com/cgi-bin/token
weChatMpUrl=https://mp.weixin.qq.com

# 自定义后台路径
ADMIN_SERVE_ROOT=/admin

# 机器码及授权码

# Midjourney 代理 URL 子串（逗号或分号分隔，不区分大小写）。命中任一段时，在未单独关闭对应逻辑的前提下启用兼容行为，例如：
# - MJ_BLEND_VIA_DISCORD_UPLOAD 未设置时，Blend 可先走 Discord 上传；
# - Blend 默认省略 botType（除非 MJ_BLEND_EP_FORCE_BOT_TYPE=1）；
# - Blend 上传转链后混图可优先裸 base64（仍受 MJ_BLEND_AFTER_UPLOAD_DATAURL 等约束）；
# - 其它与代理域名相关的兼容开关见各模块注释。
# MJ_PROXY_HOST_MARKERS=api.example.com,mj.example.net

# Midjourney 预设 Zoom Out 1.5x/2x（MJ::Outpaint::50|75 等）：多数聚合上直连 submit/action 易在执行期 invalid_parameter；服务端默认改为与「Custom Zoom」相同的两步链（先打开 modal 再 submit/modal）。
# 未设置或为空：默认启用上述链。仅当上游必须直连 Outpaint 时设 MJ_OUTPAINT_PRESET_USE_CUSTOM_ZOOM=0（或 false/off/no）。
# 设为 markers：仅当 proxyUrl 命中 MJ_PROXY_HOST_MARKERS 中任一段时启用（与旧版「未设置则按域名」行为一致）。
# MJ_OUTPAINT_PRESET_USE_CUSTOM_ZOOM=
# submit/modal 前短暂延迟（毫秒），缓解 code=21 后立刻提交被拒
# MJ_OUTPAINT_CZ_MODAL_DELAY_MS=400
# modal 提示词策略：append_ar_if_missing=1（默认）、strip_mj_zoom=1（默认）、default_ar=1:1
# MJ_OUTPAINT_CZ_MODAL_APPEND_AR_IF_MISSING=1
# MJ_OUTPAINT_CZ_MODAL_STRIP_MJ_ZOOM=1
# MJ_OUTPAINT_CZ_MODAL_DEFAULT_AR=1:1

# MJ 角色/风格/Omni 参考图上传（POST /drawing/mj/upload/ref-cdn-url）策略：
# 未设置本变量时，服务端默认 upstream（仅上游 submit/upload-discord-images，Discord CDN 官方链，MJ 文档推荐）。
# upstream = 仅上游 submit/upload-discord-images；
# self = 仅写入本站 Upload 配置（OSS/COS/S3/本地等，图链须为公网 https）；
# prefer_self = 先试本站，失败再回退上游（仅开本地存储、希望先落盘再试 MJ 时设此项）
# MJ_REF_CDN_STRATEGY=prefer_self
# 本地存储生成外链时，若后台未填 siteUrl，可读此环境变量作为站点根（与 siteUrl 二选一即可）
# PUBLIC_SITE_URL=https://你的域名

# MJ Describe（POST /drawing/mj/submit/describe）：默认先 upload-discord-images，再用返回的 https 作为 link 提交（与 OpenAPI 示例一致）。
# 个别上游只接受 body.base64、不接受 link 时设为 1 恢复旧行为。
# MJ_DESCRIBE_FORCE_BASE64=1

# Suno 音乐：proxyUrl 填 API 根，勿加 /v1（/v1 仅对话 OpenAI 兼容用）。
# ephone 等聚合走 /suno/submit/music（非 /suno/generate），已对 ephone.ai 自动识别；其它同类设 SUNO_API_FLAVOR=submit
# SUNO_API_FLAVOR=submit
# 若网关文档为 /sunoapi/*：SUNO_API_ROUTE_STYLE=sunoapi
# 歌曲拼接上游路径（默认 /suno/submit/concat）
# SUNO_CONCAT_PATH=/suno/generate/concat
# S3 多步上传路径前缀（默认 /sunoi/uploads/audio，失败时回退 /suno/uploads/audio）
# SUNO_UPLOAD_PATH_PREFIX=/sunoi/uploads/audio
