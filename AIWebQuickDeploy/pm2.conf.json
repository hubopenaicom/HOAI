{
  "apps": [
    {
      "name": "HOAI",
      "cwd": "/www/wwwroot/ai.hubopenai.com/service",
      "script": "./dist/main.js",
      "exec_mode": "fork",
      "instances": 1,
      "watch": false,
      "ignore_watch": ["node_modules", "logs", "public/file"],
      "env": {
        "TZ": "Asia/Shanghai"
      },
      "error_file": "./logs/err.log",
      "out_file": "./logs/out.log",
      "merge_logs": true,
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "max_memory_restart": "2000M"
    }
  ]
}
